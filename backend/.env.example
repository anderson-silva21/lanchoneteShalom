PORT=4000
NODE_ENV=production

# Use um segredo longo e unico em producao.
JWT_SECRET=troque-este-segredo

# Opcional. Se vazio, usa ../database/lanchonete.sqlite.
# DB_PATH=/caminho/absoluto/lanchonete.sqlite

# Separe as origens por virgula.
CORS_ORIGINS=http://100.82.234.51:4173,http://intranet.lanchoneteshalom.local

# Protecao do login.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_PER_IP=30
LOGIN_RATE_LIMIT_MAX_PER_USER=10
LOGIN_LOCK_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Backups automaticos em database/backups/.
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_BACKUP_RETENTION=14
BACKUP_BEFORE_MIGRATIONS=true

# Alertas do Telegram. O token fica no .env; os demais campos podem ser ajustados pela tela Sistema.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_GROUP_URL=
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_ALERT_INTERVAL_MINUTES=60
TELEGRAM_ALERT_MAX_ITEMS=8
TELEGRAM_IGNORE_MISSING_EXPIRATION_CATEGORIES=Descartaveis
